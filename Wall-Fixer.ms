(
    (
        (WallFixerDebugRollout.angle_of_edges_button.text == "Angle of Edges") and
        (WallFixerDebugRollout.angle_of_edges_button.width == 294) and
        (WallFixerDebugRollout.angle_of_edges_button.height == 30)
    )
